{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
